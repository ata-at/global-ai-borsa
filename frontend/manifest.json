{
  "manifest_version": 3,
  "name": "Global AI Borsa Terminali",
  "version": "1.0",
  "description": "Anlık Binance Verileri ve Yapay Zeka Finans Asistanı",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://binance.com*",
    "wss://://binance.com*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "sw.js"
  }
}
